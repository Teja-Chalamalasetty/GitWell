# Copy to .env and fill in. Placeholders only: never commit real values.
# `docker compose up --build` reads this file; the backend also reads it for local development.

# ---- core -----------------------------------------------------------------------------------
# development | test | production (docker-compose forces production)
ENV=development
# Local development default. docker-compose overrides this with its own Postgres service.
DATABASE_URL=sqlite:///./gitwell.db
# Password for the Postgres container that docker-compose starts. Choose your own.
POSTGRES_PASSWORD=

# ---- auth -----------------------------------------------------------------------------------
# REQUIRED, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Bootstrap admin: created at startup if both are set and the email is new. Password >= 8 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_REGISTRATION=false
# Trust X-Forwarded-For for login rate limiting. Only enable behind a proxy you control.
TRUST_PROXY=false

# ---- GitHub ---------------------------------------------------------------------------------
# Read access (Contents: read, Metadata: read). Optional for public repos, but anonymous access is
# limited to 60 requests/hour and cannot scan large repositories.
GITHUB_TOKEN=
# Optional, used ONLY to post issues (Issues: read & write). Falls back to GITHUB_TOKEN.
GITHUB_ISSUES_TOKEN=
GITHUB_API_URL=https://api.github.com

# ---- scanning -------------------------------------------------------------------------------
SCAN_WORKERS=2
SCAN_TIMEOUT_SECONDS=120
MAX_ARCHIVE_MB=50
MAX_UNCOMPRESSED_MB=500
MAX_FILES=100000
MAX_FILE_BYTES=524288
MAX_TEXT_TOTAL_MB=200
API_SNAPSHOT_MAX_FETCHES=40

# ---- scheduler ------------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MINUTES=15
RESCAN_INTERVAL_HOURS=24
SCHEDULER_MAX_PER_TICK=10

# ---- web / observability --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
METRICS_ENABLED=false
# Required when METRICS_ENABLED=true; scrapers send it as `Authorization: Bearer <token>`.
METRICS_TOKEN=
LOG_LEVEL=INFO
